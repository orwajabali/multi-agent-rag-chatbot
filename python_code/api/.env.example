# =====================================================
# Smart Systems Management Chatbot — Environment Config
# Copy this file to .env and fill in your credentials
# =====================================================

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=smart-system-management-chatbot

# RunPod Serverless LLM Endpoint
RUNPOD_TOKEN=your_runpod_api_token_here
RUNPOD_CHATBOT_URL=https://api.runpod.ai/v2/YOUR_CHATBOT_ENDPOINT_ID/openai/v1
RUNPOD_EMBEDDING_URL=https://api.runpod.ai/v2/YOUR_EMBEDDING_ENDPOINT_ID/openai/v1

# Model Configuration
# Requires HuggingFace access approval: https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
